# Example provisioning-related variables for deployment-api (copy into your real env / Secret Manager).
# See unified-trading-system-ui/docs/SECURITY_AUTH.md for the full threat model.

# Comma-separated emails allowed to grant admin/super_admin (required for those roles when DISABLE_AUTH=false).
ORG_OWNER_EMAILS=owner@odum-research.co.uk

# Callers must send this header on role mutations when DISABLE_AUTH=false (set by IAP / BFF / gateway).
# X-Acting-User-Email=owner@odum-research.co.uk
